# AdForge Studio — environment configuration reference.
# Copy this to .env.local and fill in real values. NEVER commit .env.local.
# .env.local is gitignored. The GEMINI_API_KEY must stay server-side only.

# --- Provider selection ---
# "mock" (default): no API calls, no cost, placeholder output for dev/tests.
# "gemini": real Gemini Omni Flash video generation (requires key + paid flag).
VIDEO_PROVIDER=mock

# --- Gemini / Google GenAI ---
# Your Gemini API key. Required ONLY when VIDEO_PROVIDER=gemini.
GEMINI_API_KEY=

# Video model id (Gemini Omni Flash).
VIDEO_MODEL=gemini-omni-1.1-flash

# --- Cost / safety controls ---
# Master kill-switch for paid generation. Must be "true" for real calls.
ENABLE_PAID_GENERATION=false

# Local dev spend ceiling (USD, estimate-based). Refuses real calls above this.
DEV_SPEND_LIMIT_USD=5

# Per-second price used ONLY for the PRE-CALL estimate and the spend guard.
# The amount shown AFTER a real generation is computed from the token usage the
# API actually reports (see per-token rates below), not from this figure.
VIDEO_USD_PER_SECOND=0.10

# --- Real per-token rates (used to turn reported token usage into $ spent) ---
# Gemini Omni Flash bills per token across three meters. Defaults are Google's
# published introductory rates (USD per 1,000,000 tokens). Confirm the current
# numbers for your tier at https://ai.google.dev/gemini-api/docs/pricing.
#   video output ≈ 5,792 tokens per second of 720p  (=> ~$0.10/s at $17.50/1M)
GEMINI_INPUT_USD_PER_M=1.50
GEMINI_TEXT_OUTPUT_USD_PER_M=9.00
GEMINI_VIDEO_OUTPUT_USD_PER_M=17.50

# --- Reference: Tier 1 quota (informational; the API enforces the real limits) ---
# gemini-omni-1.1-flash: ~4 requests/min, ~20 requests/day.
# NOTE: 20 requests/day is capacity, NOT 20 free videos — each billable call
# still incurs per-token charges. 20 x 8s/720p ≈ $16 output + input charges.
