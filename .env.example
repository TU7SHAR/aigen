# MakeAdClips Studio — environment configuration reference.
# Copy to .env.local (or .env.development for `next dev`) and fill in values.
# NEVER commit real keys. GEMINI_API_KEY and every *_SECRET stay server-side.
# Full reference: docs/operations/CONFIGURATION.md

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://makeadclips.com

# --- Keys ---
GEMINI_API_KEY=
# FIRECRAWL_API_KEY=                 # optional rendered-crawl fallback
# CRAWL_PROVIDER=firecrawl           # force Firecrawl as the primary crawler

# --- Paid generation gates (ALL must allow a paid call; safe defaults = off) ---
VIDEO_PROVIDER=mock                  # "gemini" for real video
ENABLE_PAID_GENERATION=false         # "true" to allow paid video
# DISABLE_PAID_GENERATION=true       # global kill-switch; "false" lifts it
# ENABLE_PAID_IMAGE_GENERATION=false
# IMAGE_PROVIDER=mock                # "gemini" for real keyframes
# ENABLE_PAID_AUDIO_GENERATION=false

# --- Model routing (cheapest current model first; automatic switching) ---
# Each chain is tried in order; a model is skipped when it is exhausted for
# the day, rate limited, unavailable, cannot make the shot, or would exceed
# the job budget. Switching never happens after an outcome that might still be
# billed. Verified ids and prices: lib/ai/modelRegistry.js (2026-10-17).
# VIDEO_MODEL_CHAIN=veo-3.1-lite,veo-3.1-fast,gemini-omni-1.1-flash,gemini-omni-flash-preview
# IMAGE_MODEL_CHAIN=gemini-nano-banana-2.1,gemini-3.1-flash-lite-image,gemini-3.1-flash-image
# TTS_MODEL_CHAIN=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# MUSIC_MODEL_CHAIN=lyria-3-clip-preview,lyria-3-pro-preview
# CREATIVE_MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# ENRICHMENT_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
# VIDEO_AUTO_SWITCH=true             # "false" = only the first video model, failures reported
# MODEL_AUTO_SWITCH=true             # "false" disables switching for every family
# MODEL_MAX_WAIT_MS=                 # wait this long for a per-minute window before switching (video default 65000)
# Legacy single-model vars still work as the chain head: VIDEO_MODEL, IMAGE_MODEL,
# TTS_MODEL, MUSIC_MODEL, SOURCE_ENRICHMENT_MODEL.
# Account rate limits per model (defaults = Tier-1 dashboard values):
# MODEL_LIMITS__VEO_3_1_LITE=rpm:2,rpd:10
# TTS_VOICE=Charon

# --- Spending (local estimates from published prices; not an invoice) ---
JOB_MAX_USD=0.50                     # per video
# JOB_MAX_PAID_VIDEO_CLIPS=0         # AI-video shots per video (0 = off)
# JOB_MAX_PAID_IMAGES=4
# JOB_MAX_PAID_AUDIO=0               # 2 = voiceover + music
DAILY_SPEND_LIMIT_USD=10             # durable, all processes, survives restarts
MONTHLY_SPEND_LIMIT_USD=60
# IMAGE_USD_PER_IMAGE=0.07           # worst-case reservations
# TTS_USD_PER_CALL=0.02
# MUSIC_USD_PER_CALL=0.08

# --- Jobs, storage, cache ---
# JOB_EXECUTION=inline               # "worker" = web only enqueues; run `node scripts/worker.mjs`
# MAC_DATA_DIR=./.data               # jobs, exports, raw media, quota, spend ledger
# MEDIA_CACHE=on                     # "off" disables reuse of paid clips/audio
# SCENE_MEDIA_CACHE_DIR=             # override the media cache location
# SHOT_CONCURRENCY=3                 # shots generated in parallel
# RENDER_CONCURRENCY=2               # ffmpeg scene renders in parallel
# RENDER_FINAL_PRESET=medium
# RENDER_FINAL_CRF=18
# VEO_POLL_TIMEOUT_MS=420000

# --- Rendered website capture (trusted local use only) ---
# ENABLE_RENDERED_CAPTURE=false
# ACKNOWLEDGE_CAPTURE_UNSAFE=false   # required; see docs/security/SECURITY.md
# CAPTURE_NETWORK_ISOLATED=false     # required in production (egress isolation must exist)

# --- Self-hosted Modal worker (optional; only routed when listed in VIDEO_MODEL_CHAIN) ---
# MODAL_VIDEO_ENDPOINT=
# MODAL_WORKER_SECRET=
# MODAL_GPU_USD_PER_SECOND=0.000337
# MODAL_MONTHLY_BUDGET_USD=30

# --- ffmpeg (bundled; override only for a custom build) ---
# FFMPEG_PATH=
# FFPROBE_PATH=
